# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI API key for personalized Polish report generation (server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Secret Key (required for checkout; starts with sk_test_... or sk_live_..., NOT pk_...)
STRIPE_SECRET_KEY=""

# Optional Stripe Webhook Signing Secret (starts with whsec_...; only needed in production, not required for testing)
STRIPE_WEBHOOK_SECRET=""

# Resend API Key for automatic full report email delivery (free tier: 3,000 emails/mo at resend.com; starts with re_...)
RESEND_API_KEY=""

# Sender address for Resend (use "Solaris 2027 <onboarding@resend.dev>" for quick tests, or "Solaris 2027 <raport@solaris27.pl>" after verifying solaris27.pl in Resend)
EMAIL_FROM="Solaris 2027 <raport@solaris27.pl>"

